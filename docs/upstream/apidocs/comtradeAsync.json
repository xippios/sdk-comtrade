                                            "reporterCode": "842",
                                            "cmdCode": "AG6",
                                            "partnerCode": null,
                                            "clCode": "HS",
                                            "partner2Code": null,
                                            "customsCode": null,
                                            "motCode": null,
                                            "mosCode": null,
                                            "recordCount": 1210614.0,
                                            "userId": "user@example.org",
                                            "reqId": "3f2b8c1e-7d4a-4f6e-9b1a-2c5d8e0f4a67",
                                            "requestType": "Final",
                                            "breakdownMode": null,
                                            "aggregateBy": null,
                                            "objectId": "*****",
                                            "emailId": "user@example.org",
