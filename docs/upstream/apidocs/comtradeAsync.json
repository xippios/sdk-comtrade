{
    "openapi": "3.0.1",
    "info": {
        "title": "comtradeAsync",
        "description": "Premium APIs for asynchronous requests. You will be notified through email about your results sets. Please add your email in the userId parameter. You must also pass subscription key. See examples at https://bit.ly/42JNSaZ",
        "version": "v1"
    },
    "servers": [
        {
            "url": "https://comtradeapi.un.org/async/v1"
        }
    ],
    "paths": {
        "/get/{typeCode}/{freqCode}/{clCode}": {
            "get": {
                "summary": "get",
                "description": "Submit the async request.",
                "operationId": "get-get",
                "parameters": [
                    {
                        "name": "typeCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "enum": [
                                "C",
                                "S"
                            ],
                            "type": "string"
                        }
                    },
                    {
                        "name": "freqCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "enum": [
                                "A",
                                "M"
                            ],
                            "type": "string"
                        }
                    },
                    {
                        "name": "clCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "enum": [
                                "HS",
                                "SS",
                                "S4",
                                "S3",
                                "S2",
                                "S1",
                                "BE",
                                "BE5",
                                "EB",
                                "EB02",
                                "EB10",
                                "TM"
                            ],
                            "type": "string"
                        }
                    },
                    {
                        "name": "reporterCode",
                        "in": "query",
                        "description": "Reporter code (Possible values are code of the countries separated by comma (,))",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "period",
                        "in": "query",
                        "description": "Year or month. Year should be 4 digit year. Month should be six digit integer with the values of the form YYYYMM. Ex: 201002 for 2010 February. Multi value input should be in the form of csv (Codes separated by comma (,))",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "partnerCode",
                        "in": "query",
                        "description": "Partner code (Possible values are code of the countries separated by comma (,))",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "partner2Code",
                        "in": "query",
                        "description": "Second partner/consignment code (Possible values are code of the countries separated by comma (,))",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "cmdCode",
                        "in": "query",
                        "description": "Commodity code. Multi value input should be in the form of csv (Codes separated by comma (,))",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "flowCode",
                        "in": "query",
                        "description": "Trade flow code. Multi value input should be in the form of csv (Codes separated by comma (,)) Allowed values (case-insensitive): M, X, RX, RM, MIP, XIP, MOP, XOP, MIF, XIF, DX, FM. Omit to not filter.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "customsCode",
                        "in": "query",
                        "description": "Customs code. Multi value input should be in the form of csv (Codes separated by comma (,)) Allowed values: C00, C01, C02, C03, C04, C05, C06, C07, C08, C09, C10, C11, C12, C13, C14, C15, C20. Omit to not filter.",
                        "schema": {
                            "type": "string",
                            "pattern": "^((C|c)([0][0-9]|[1][0-5]|20))(,(C|c)([0][0-9]|[1][0-5]|20))*$"
                        }
                    },
                    {
                        "name": "motCode",
                        "in": "query",
                        "description": "Mode of transport code. Multi value input should be in the form of csv (Codes separated by comma (,)) Allowed values: 0, 1000, 2000, 2100, 2200, 2900, 3000, 3100, 3200, 3900, 9000, 9100, 9110, 9120, 9190, 9200, 9300, 9900. Omit to not filter.",
                        "schema": {
                            "type": "string",
                            "pattern": "^(0|1000|2000|2100|2200|2900|3000|3100|3200|3900|9000|9100|9110|9120|9190|9200|9300|9900)(,(0|1000|2000|2100|2200|2900|3000|3100|3200|3900|9000|9100|9110|9120|9190|9200|9300|9900))*$"
                        }
                    },
                    {
                        "name": "aggregateBy",
                        "in": "query",
                        "description": "Add parameters in csv list on which you want the results to be aggregated. Comma-separated list of: cmdCode, period, partnerCode, partner2Code, reporterCode, customsCode, motCode",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "breakdownMode",
                        "in": "query",
                        "description": "Mode to choose from",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "classic",
                                "plus"
                            ]
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted: the export is queued and the requester is emailed when it's ready.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AsyncSubmitResponse"
                                },
                                "example": {
                                    "elapsedTime": "0.21 secs",
                                    "count": 0,
                                    "requestId": "3f2b8c1e-7d4a-4f6e-9b1a-2c5d8e0f4a67",
                                    "message": "Your request is accepted.You will be notified through your email when the data is ready for download",
                                    "data": {},
                                    "error": false
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid parameter value, or no valid requester email.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid subscription key (API Management).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GatewayError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Daily quota exhausted, or the subscription does not include API access (API Management).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GatewayError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded (API Management). See the Retry-After header.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GatewayError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/getTariffline/{typeCode}/{freqCode}/{clCode}": {
