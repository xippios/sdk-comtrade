    },
    "components": {
        "securitySchemes": {
            "apiKeyHeader": {
                "type": "apiKey",
                "name": "Ocp-Apim-Subscription-Key",
                "in": "header"
            },
            "apiKeyQuery": {
                "type": "apiKey",
                "name": "subscription-key",
                "in": "query"
            }
        },
        "schemas": {
            "ValidationError": {
                "type": "object",
                "properties": {
                    "memberNames": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Parameters that failed validation."
                    },
                    "errorMessage": {
                        "type": "string"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "description": "Error body returned by the backend with a 4xx/5xx status.",
                "properties": {
                    "error": {
                        "type": "string",
                        "description": "Error message."
                    },
                    "details": {
                        "type": "array",
                        "nullable": true,
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "description": "Per-parameter validation failures (400 only); null otherwise."
                    }
                }
            },
            "GatewayError": {
                "type": "object",
                "description": "Returned by API Management before the request reaches the backend.",
                "properties": {
                    "statusCode": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "AsyncSubmitResponse": {
                "type": "object",
                "description": "Returned with 202 Accepted once the request is queued.",
                "properties": {
                    "elapsedTime": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Always 0."
                    },
                    "requestId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Request id; pass it as batchId to getDa to track progress."
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "type": "object",
                        "description": "Always an empty object."
                    },
                    "error": {
                        "type": "boolean",
                        "description": "Always false."
                    }
                }
            },
            "AsyncBatchRecord": {
                "type": "object",
                "properties": {
                    "partitionKey": {
                        "type": "string",
                        "nullable": true,
                        "description": "The requester's email"
                    },
                    "rowKey": {
                        "type": "string",
                        "nullable": true,
                        "description": "Request id (same as reqId)"
                    },
                    "timestamp": {
                        "type": "string",
                        "nullable": true,
                        "description": "ISO 8601 date-time with UTC offset"
                    },
                    "eTag": {
                        "type": "object",
                        "description": "Always an empty object."
                    },
                    "uri": {
                        "type": "string",
                        "nullable": true,
                        "description": "Download URL of the zipped result; set once status is Completed."
                    },
                    "size": {
                        "type": "string",
                        "nullable": true,
                        "description": "Result file size in bytes"
                    },
                    "startTime": {
                        "type": "string",
                        "nullable": true
                    },
                    "endTime": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "nullable": true,
                        "description": "Submitted | Processing | Completed | Failed"
                    },
                    "error": {
                        "type": "string",
                        "nullable": true,
                        "description": "Failure detail when status is Failed"
                    },
                    "period": {
                        "type": "string",
                        "nullable": true
                    },
                    "typeCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "freqCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "flowCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "reporterCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "cmdCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "partnerCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "clCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "partner2Code": {
                        "type": "string",
                        "nullable": true
                    },
                    "customsCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "motCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "mosCode": {
                        "type": "string",
                        "nullable": true
                    },
                    "recordCount": {
                        "type": "number",
                        "format": "double"
                    },
                    "userId": {
                        "type": "string",
                        "nullable": true
                    },
                    "reqId": {
                        "type": "string",
                        "nullable": true
                    },
                    "requestType": {
                        "type": "string",
                        "nullable": true
                    },
                    "breakdownMode": {
                        "type": "string",
                        "nullable": true
                    },
                    "aggregateBy": {
                        "type": "string",
                        "nullable": true
                    },
                    "objectId": {
                        "type": "string",
                        "nullable": true
                    },
                    "emailId": {
                        "type": "string",
                        "nullable": true
                    },
                    "ipAddress": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "description": "Status of one asynchronous export request."
            },
            "AsyncStatusResponse": {
                "type": "object",
                "description": "Status of the caller's asynchronous requests.",
                "properties": {
                    "userId": {
                        "type": "string",
                        "nullable": true,
                        "description": "The requester's email."
                    },
                    "elapsedTime": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AsyncBatchRecord"
                        }
                    },
                    "error": {
                        "type": "boolean",
                        "description": "Always false."
                    }
                }
            }
        }
    },
    "security": [
        {
            "apiKeyHeader": []
        },
        {
            "apiKeyQuery": []
        }
    ]
}