                    }
                }
            }
        },
        "/getDa": {
            "get": {
                "summary": "getDa",
                "description": "Get the status of async -- including the location of file for download.",
                "operationId": "get-getda",
                "parameters": [
                    {
                        "name": "batchId",
                        "in": "query",
                        "description": "",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status of the caller's requests (all of them, or the one matching batchId).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AsyncStatusResponse"
                                },
                                "example": {
                                    "userId": "user@example.org",
                                    "elapsedTime": "0.18 secs",
                                    "count": 1,
                                    "data": [
                                        {
                                            "partitionKey": "user@example.org",
                                            "rowKey": "3f2b8c1e-7d4a-4f6e-9b1a-2c5d8e0f4a67",
                                            "timestamp": "2026-09-24T14:09:37.512+00:00",
                                            "eTag": {},
                                            "uri": "https://*****/*****.zip",
                                            "size": "18874368",
                                            "startTime": "2026-09-24T14:05:12.4810000Z",
                                            "endTime": "2026-09-24T14:09:37.1200000Z",
                                            "status": "Completed",
                                            "error": null,
                                            "period": "2022",
                                            "typeCode": "C",
                                            "freqCode": "A",
